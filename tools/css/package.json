{
  "name": "pim-dash-css",
  "private": true,
  "version": "1.0.0",
  "description": "Tailwind v4 build for assets/style.css (dev-time only; the compiled CSS is committed)",
  "scripts": {
    "build": "tailwindcss -i input.css -o ../../assets/style.css --minify",
    "watch": "tailwindcss -i input.css -o ../../assets/style.css --watch"
  },
  "dependencies": {
    "@tailwindcss/cli": "^4.3.5",
    "lucide-static": "^1.70.0",
    "shadcn": "^3.8.5",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0"
  }
}
