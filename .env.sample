# ──────────────────────────────────────────────────────────────────────────────────────────────
# PIM Policy Profiles AI (Dash)  ·  environment variables
#
# Local development:  copy this file to `.env` and fill it in.
# Posit Connect:      do NOT upload `.env`; set the same names under  Content ▸ Vars  (secrets are encrypted).
# ──────────────────────────────────────────────────────────────────────────────────────────────

# ── 1. Posit mAI gateway  (see "Posit mAI Gateway – Developer Guide") ─────────────────────────────
MAI_BASE_URL=

MAI_ENDPOINT_OPENAI=
MAI_ENDPOINT_CLAUDE=
MAI_ENDPOINT_GEMINI=

# ── 2. Azure Databricks · Unity Catalog  (catalog prd_mega · schema sgpbpi163) ───────────────────
DATABRICKS_SERVER_HOSTNAME=adb-0000000000000000.0.azuredatabricks.net   # workspace host, without https://
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/xxxxxxxxxxxxxxxx               # SQL warehouse ▸ Connection details
DATABRICKS_CLIENT_ID=                            # OAuth M2M service principal – application (client) ID
DATABRICKS_CLIENT_SECRET=                        # OAuth M2M service principal – secret   (keep out of git!)

# Defaults already point at the right place; override only if you move the data.
# DATABRICKS_CATALOG=prd_mega
# DATABRICKS_SCHEMA=sgpbpi163
# Uploaded documents are written (upload only – never read back) to
#   /Volumes/<catalog>/<schema>/<DATABRICKS_VOLUME>/<PIM_FILES_FOLDER>/<PIM_DOCUMENTS_FOLDER>/<ISO3>_<Country>/<National|Subnational>/
# DATABRICKS_VOLUME=vgpbpi163
# PIM_FILES_FOLDER=PIMPAM-AI/policy-profiles/upload-files
# PIM_DOCUMENTS_FOLDER=documents/upload-documents

# ── Search index: Databricks AI Search (formerly Vector Search) ─────────────────────────────────────
# Uploads are chunked by the app into the Delta table policy_repo_document_chunks; the app then asks the index
# (created in Databricks, see docs/AI_SEARCH.md) to sync.  Until the endpoint exists, set bm25.
# PIM_SEARCH_BACKEND=ai_search                 # ai_search (default on Databricks) | bm25 (keyword search, no endpoint)
# PIM_AI_SEARCH_ENDPOINT=pim_policy_profiles_ai_search
# PIM_AI_SEARCH_INDEX=prd_mega.sgpbpi163.policy_repo_document_chunks_index
# PIM_AI_SEARCH_QUERY_TYPE=HYBRID              # HYBRID (vectors + keywords) | ANN (vectors only)
# PIM_AI_SEARCH_RERANK=0                       # 1 = Databricks reranker (better ordering, adds latency)
# PIM_AI_SEARCH_FALLBACK=1                     # fall back to BM25 over the same table if an AI Search query fails
# PIM_AI_SEARCH_SYNC=1                         # ask the index to sync after uploads (needs the SP to own / manage the index)
# PIM_AI_SEARCH_SYNC_DEBOUNCE=20               # seconds to batch several uploads into one sync
# PIM_AI_SEARCH_EMBEDDING_MODEL=databricks-qwen3-embedding-0-6b   # informational (shown on the Statistics page)

# Partner API (/api/v1/*): off until the policy_repo_partner_api_keys table exists, then set to 1.
# PIM_PARTNER_API=0

# ── 3. Sign-in / sessions ─────────────────────────────────────────────────────────────────────────
# Signs the session cookie of local accounts – set a long random value (python -c "import secrets;print(secrets.token_hex(32))").
PIM_SECRET_KEY=
# Needed to register accounts after the first one (the first account is created freely). Same role as in the Next.js app.
ADMIN_INVITE_CODE=

# ── Databricks AI Search Endpoint ───────────────────────────────────────────────────────────────────────────────────
PIM_SEARCH_BACKEND=
PIM_AI_SEARCH_ENDPOINT=
PIM_AI_SEARCH_INDEX=
PIM_AI_SEARCH_QUERY_TYPE=HYBRID
PIM_AI_SEARCH_RERANK=0
PIM_AI_SEARCH_SYNC=1

# ── 4. Optional ───────────────────────────────────────────────────────────────────────────────────
# Bearer token that lets a scheduler call GET /api/imf-pima/refresh without signing in.
# CRON_SECRET=
# Comma-separated CORS origins for GET /api/export/documents (empty = any origin).
# EXPORT_ALLOWED_ORIGINS=
# Public origin used in generated briefings ("contribute at <url>/"); empty = the URL of the running app.
# PUBLIC_BASE_URL=

# Tuning
# PIM_CACHE_SECONDS=60                 # read cache for list/aggregate queries
# PIM_JOB_WORKERS=6                    # background-job threads (batch import, briefings, translation, re-index)
# PIM_JOBS_DIR=                        # where job progress files are written (default: system temp dir)
# PIM_MAX_TRANSLATE_CHARS=600000
# PIM_TRANSLATE_WORKERS=3
# LOG_LEVEL=INFO

# ── 5. Local UI preview only (never on Connect) ───────────────────────────────────────────────────
# Runs the whole app on a local SQLite file + local folder instead of Databricks, and fakes the mAI replies:
#   export PIM_DB_BACKEND=sqlite PIM_MAI_MOCK=1;  python scripts/seed_demo.py --reset;  python app.py
# PIM_DB_BACKEND=sqlite
# PIM_MAI_MOCK=1
# PIM_SQLITE_PATH=.local/demo.sqlite
# PIM_LOCAL_STORAGE=.local/files
# DASH_DEBUG=0
# PORT=8050
