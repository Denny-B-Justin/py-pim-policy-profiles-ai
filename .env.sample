# ──────────────────────────────────────────────────────────────────────────────────────────────
# PIM Policy Profiles AI (Dash)  ·  environment variables
#
# Local development:  copy this file to `.env` and fill it in.
# Posit Connect:      do NOT upload `.env`; set the same names under  Content ▸ Vars  (secrets are encrypted).
# ──────────────────────────────────────────────────────────────────────────────────────────────

# ── 1. Posit mAI gateway  –  the ONLY two variables the AI features need ─────────────────────────
# No API keys, tokens or client details. Posit Connect already carries the identity: the app sends the
# content GUID that Connect injects automatically (CONNECT_CONTENT_GUID – never set it yourself).
MAI_BASE_URL=https://<mai-gateway-host>/        # gateway URL – must end with "/"   (QA and Production differ)
MAI_ENDPOINT=                                    # the mai-endpoint for your provider: OpenAI / Claude / Gemini (see the Developer Guide)

# Optional. Only for OpenAI / Gemini endpoints (the Claude model is part of the endpoint).
# Allowed: gpt-6-luna, gpt-5.6-luna, gemini-3.1-flash-lite, gemini-3.5-flash-lite, gemini-3.6-flash, gemini-3.7-flash, gemini-3.8-flash
# MAI_MODEL=
# MAI_TIMEOUT_SECONDS=240

# ── 2. Azure Databricks · Unity Catalog  (catalog prd_mega · schema sgpbpi163) ───────────────────
DATABRICKS_SERVER_HOSTNAME=adb-0000000000000000.0.azuredatabricks.net   # workspace host, without https://
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/xxxxxxxxxxxxxxxx               # SQL warehouse ▸ Connection details
DATABRICKS_CLIENT_ID=                            # OAuth M2M service principal – application (client) ID
DATABRICKS_CLIENT_SECRET=                        # OAuth M2M service principal – secret   (keep out of git!)

# Defaults already point at the right place; override only if you move the data.
# DATABRICKS_CATALOG=prd_mega
# DATABRICKS_SCHEMA=sgpbpi163
# DATABRICKS_VOLUME=policy_repo_documents                # UC Volume holding the policy files (replaces Vercel Blob)

# ── 3. Sign-in / sessions ─────────────────────────────────────────────────────────────────────────
# Signs the session cookie of local accounts – set a long random value (python -c "import secrets;print(secrets.token_hex(32))").
PIM_SECRET_KEY=
# Needed to register accounts after the first one (the first account is created freely). Same role as in the Next.js app.
ADMIN_INVITE_CODE=

# ── 4. Optional ───────────────────────────────────────────────────────────────────────────────────
# Bearer token that lets a scheduler call GET /api/rag-sync/reconcile and /api/imf-pima/refresh without signing in.
# CRON_SECRET=
# Extra key requested on /?page=raging (the original "Admin API Key" field). Unset = signed-in users only.
# RAG_ADMIN_KEY=
# Comma-separated CORS origins for GET /api/export/documents (empty = any origin).
# EXPORT_ALLOWED_ORIGINS=
# Public origin used in generated briefings ("contribute at <url>/"); empty = the URL of the running app.
# PUBLIC_BASE_URL=

# Tuning
# PIM_CACHE_SECONDS=60                 # read cache for list/aggregate queries
# PIM_JOB_WORKERS=6                    # background-job threads (batch import, briefings, translation, re-index)
# PIM_JOBS_DIR=                        # where job progress files are written (default: system temp dir)
# PIM_MAX_TRANSLATE_CHARS=600000
# PIM_TRANSLATE_WORKERS=3
# LOG_LEVEL=INFO

# ── 5. Local UI preview only (never on Connect) ───────────────────────────────────────────────────
# Runs the whole app on a local SQLite file + local folder instead of Databricks, and fakes the mAI replies:
#   export PIM_DB_BACKEND=sqlite PIM_MAI_MOCK=1;  python scripts/seed_demo.py --reset;  python app.py
# PIM_DB_BACKEND=sqlite
# PIM_MAI_MOCK=1
# PIM_SQLITE_PATH=.local/demo.sqlite
# PIM_LOCAL_STORAGE=.local/files
# DASH_DEBUG=0
# PORT=8050
