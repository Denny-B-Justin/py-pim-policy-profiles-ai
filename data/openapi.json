{
  "openapi": "3.1.0",
  "info": {
    "title": "PIM Policy Profiles AI — Partner API",
    "version": "1.0.0",
    "description": "API surface for partner integrations (e.g. national ePIM-CBA\ndeployments). All endpoints require an `X-API-Key` header issued\nby the platform operator. Rate-limited per key.\n\nNeed a key? Contact the platform operator.",
    "contact": {
      "name": "PIM Policy Profiles AI"
    },
    "license": {
      "name": "Proprietary"
    }
  },
  "servers": [
    {
      "url": "{{ORIGIN}}/api/v1",
      "description": "Production"
    }
  ],
  "security": [
    {
      "apiKey": []
    }
  ],
  "components": {
    "securitySchemes": {
      "apiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key",
        "description": "Partner API key. Format `pim_v1_<32 hex chars>`. Issued by the operator."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string",
                "example": "Unauthorized"
              },
              "message": {
                "type": "string",
                "example": "Missing or invalid X-API-Key."
              }
            }
          }
        }
      },
      "Country": {
        "type": "object",
        "properties": {
          "iso3": {
            "type": "string",
            "example": "LTU"
          },
          "name": {
            "type": "string",
            "example": "Lithuania"
          },
          "gdp_2024_bn": {
            "type": "number",
            "nullable": true,
            "example": 78.4
          },
          "pub_inv_pct_gdp": {
            "type": "number",
            "nullable": true,
            "example": 4.1
          },
          "pub_inv_2024_bn": {
            "type": "number",
            "nullable": true,
            "example": 3.21
          }
        }
      },
      "CountriesResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Country"
            }
          },
          "count": {
            "type": "integer",
            "example": 195
          }
        }
      },
      "PolicyRecord": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "country": {
            "type": "string",
            "example": "LTU"
          },
          "name_eng": {
            "type": "string"
          },
          "name_orig": {
            "type": "string",
            "nullable": true
          },
          "year": {
            "type": "integer",
            "nullable": true
          },
          "year_revised": {
            "type": "integer",
            "nullable": true
          },
          "source": {
            "type": "string",
            "nullable": true
          },
          "overview": {
            "type": "string",
            "nullable": true
          },
          "policy_guidance_tier": {
            "type": "integer",
            "nullable": true,
            "minimum": 1,
            "maximum": 3
          },
          "strategy_tier": {
            "type": "integer",
            "nullable": true,
            "minimum": 1,
            "maximum": 3
          },
          "link": {
            "type": "string",
            "nullable": true
          },
          "pages": {
            "type": "integer",
            "nullable": true
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "PolicyRecordsResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PolicyRecord"
            }
          },
          "count": {
            "type": "integer",
            "example": 50
          },
          "limit": {
            "type": "integer",
            "example": 50
          },
          "offset": {
            "type": "integer",
            "example": 0
          },
          "has_more": {
            "type": "boolean",
            "example": true
          }
        }
      },
      "Document": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "lang_type": {
            "type": "string",
            "enum": [
              "ENG",
              "ORI"
            ]
          },
          "lang_code": {
            "type": "string",
            "nullable": true,
            "example": "lt"
          },
          "lang_label": {
            "type": "string",
            "nullable": true,
            "example": "Lithuanian"
          },
          "file_name": {
            "type": "string",
            "nullable": true
          },
          "file_size": {
            "type": "integer",
            "nullable": true
          }
        }
      },
      "PolicyRecordWithDocsResponse": {
        "type": "object",
        "properties": {
          "data": {
            "allOf": [
              {
                "$ref": "#/components/schemas/PolicyRecord"
              },
              {
                "type": "object",
                "properties": {
                  "documents": {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/Document"
                    }
                  }
                }
              }
            ]
          }
        }
      },
      "CoachQueryRequest": {
        "type": "object",
        "required": [
          "question"
        ],
        "properties": {
          "question": {
            "type": "string",
            "example": "What is the appraisal threshold in Lithuania?"
          },
          "country": {
            "type": "string",
            "nullable": true,
            "example": "LTU",
            "description": "Optional ISO-3 country filter."
          },
          "chat_history": {
            "type": "array",
            "nullable": true,
            "items": {
              "type": "object",
              "properties": {
                "role": {
                  "type": "string",
                  "enum": [
                    "user",
                    "assistant"
                  ]
                },
                "content": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "CoachQueryResponse": {
        "type": "object",
        "properties": {
          "answer": {
            "type": "string"
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "content": {
                  "type": "string"
                },
                "metadata": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "Missing or invalid `X-API-Key`.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "BadRequest": {
        "description": "Malformed request.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "NotFound": {
        "description": "Resource not found.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "RateLimited": {
        "description": "Per-key rate limit exceeded.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "headers": {
          "Retry-After": {
            "schema": {
              "type": "integer"
            }
          },
          "X-RateLimit-Limit": {
            "schema": {
              "type": "integer"
            }
          },
          "X-RateLimit-Remaining": {
            "schema": {
              "type": "integer"
            }
          },
          "X-RateLimit-Reset": {
            "schema": {
              "type": "integer"
            }
          }
        }
      }
    }
  },
  "paths": {
    "/countries": {
      "get": {
        "summary": "List countries with public-investment context",
        "tags": [
          "Repository"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CountriesResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      }
    },
    "/records": {
      "get": {
        "summary": "List curated policy records",
        "tags": [
          "Repository"
        ],
        "parameters": [
          {
            "name": "country",
            "in": "query",
            "schema": {
              "type": "string",
              "pattern": "^[A-Z]{3}$"
            },
            "example": "LTU",
            "description": "ISO-3 country code filter."
          },
          {
            "name": "tier",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3
            },
            "description": "Filter by policy_guidance_tier."
          },
          {
            "name": "strategy",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3
            },
            "description": "Filter by strategy_tier."
          },
          {
            "name": "search",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Free-text match on name + overview."
          },
          {
            "name": "year_from",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "year_to",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200,
              "default": 50
            }
          },
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PolicyRecordsResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      }
    },
    "/records/{id}": {
      "get": {
        "summary": "Get a single record with its document links",
        "tags": [
          "Repository"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PolicyRecordWithDocsResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      }
    },
    "/coach/query": {
      "post": {
        "summary": "Ask the AI Coach a question",
        "description": "Retrieves the most relevant policy passages (BM25 full-text search over the indexed documents) and answers with the Posit mAI gateway. Returns the cited answer plus the source chunks.",
        "tags": [
          "AI Coach"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CoachQueryRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CoachQueryResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "502": {
            "description": "The mAI gateway is unreachable or returned an error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Repository",
      "description": "Curated policy repository read endpoints."
    },
    {
      "name": "AI Coach",
      "description": "Country-scoped RAG queries."
    }
  ]
}